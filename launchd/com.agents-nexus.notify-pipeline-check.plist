<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agents-nexus.notify-pipeline-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>python3</string>
        <string>__AGENTS_NEXUS_DIR__/scripts/notify-pipeline-check.py</string>
        <string>--window-hours</string>
        <string>2</string>
    </array>

    <!-- Hourly. The 2h window keeps a dead classifier from being averaged away,
         and the script's own 6h per-condition cooldown stops it re-pinging. -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>AGENTS_NEXUS_DIR</key>
        <string>__AGENTS_NEXUS_DIR__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:__HOME__/.local/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/agents-nexus-notify-pipeline-check.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/agents-nexus-notify-pipeline-check.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
