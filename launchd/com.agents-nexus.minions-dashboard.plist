<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agents-nexus.minions-dashboard</string>

    <!-- Read-only status page for the cron minions and the factory on http://127.0.0.1:8312.
         The script re-execs into agent-runner/.venv when the system python lacks psycopg, so
         the missions table works without a PATH tweak here. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>python3</string>
        <string>__AGENTS_NEXUS_DIR__/scripts/minions-dashboard.py</string>
        <string>serve</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__AGENTS_NEXUS_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>AGENTS_NEXUS_DIR</key>
        <string>__AGENTS_NEXUS_DIR__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:__HOME__/.local/bin</string>
    </dict>

    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/agents-nexus/minions-dashboard.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/agents-nexus/minions-dashboard.log</string>
</dict>
</plist>
